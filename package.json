{
  "name": "iagent",
  "version": "0.1.0",
  "private": true,
  "description": "iAgente — host/external-app orchestration framework",
  "license": "MIT",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "test": "pnpm -r --filter=./packages/* run test",
    "typecheck": "pnpm -r --filter=./packages/* run typecheck",
    "lint": "pnpm -r --filter=./packages/* run lint",
    "clean": "pnpm -r exec rimraf dist *.tsbuildinfo",
    "test:ui": "vitest --ui",
    "dev:demo": "pnpm --filter @iagente/runtime-script-tag dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/ui": "^2.1.0",
    "prettier": "^3.4.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
